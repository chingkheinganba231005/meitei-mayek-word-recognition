    given-names: Chingkheinganba
    affiliation: "School of Computing and Data Science, The University of Hong Kong"
    orcid: "https://orcid.org/0009-0002-2620-0281"
repository-code: "https://github.com/chingkheinganba231005/meitei-mayek-word-recognition"
url: "https://huggingface.co/spaces/Chingkheinganba/handwritten-meitei-mayek-word-recognition"
license: MIT
keywords:
  - Meitei Mayek
  - Manipuri
  - handwritten text recognition
  - synthetic training data
  - connectionist temporal classification
version: 1.0.0
